# ==============================================================================
# MyBookConnect - Configuración de Variables de Entorno para PRODUCCIÓN
# Fase 29 - Preparación de Producción
# ==============================================================================
# IMPORTANTE:
# 1. Copia este archivo a `.env` en tu servidor de producción o inyéctalo vía Secrets Manager / Vault.
# 2. NUNCA subas el archivo `.env` real a ningún repositorio de código.
# 3. Asegúrate de generar un SECRET_KEY robusto y único de al menos 50 caracteres.
# ==============================================================================

# ─── Configuración Básica y Seguridad del Núcleo ───
# En producción, DEBUG debe ser OBLIGATORIAMENTE 0
DEBUG=0
SECRET_KEY=genera_una_clave_criptografica_aleatoria_de_al_menos_50_caracteres_aqui
DJANGO_ADMIN_URL=admin-panel-ofuscado-mbc/

# Dominios autorizados para atender peticiones HTTP (separados por espacio)
DJANGO_ALLOWED_HOSTS=mybookconnect.com www.mybookconnect.com api.mybookconnect.com
ALLOWED_HOSTS=mybookconnect.com www.mybookconnect.com api.mybookconnect.com

# Orígenes confiables para Cross-Origin Resource Sharing (CORS) y CSRF (separados por espacio)
CORS_ALLOWED_ORIGINS=https://mybookconnect.com https://www.mybookconnect.com
CSRF_TRUSTED_ORIGINS=https://mybookconnect.com https://www.mybookconnect.com

# ─── Seguridad HTTPS, SSL y Cabeceras HSTS ───
USE_X_FORWARDED_PROTO=1
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# ─── Base de Datos Relacional (PostgreSQL 16 Gestionada con pgvector) ───
POSTGRES_DB=mybookconnect_prod
POSTGRES_USER=mbc_prod_admin
POSTGRES_PASSWORD=password_ultraseguro_generado_aleatoriamente
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Caché, Message Broker y WebSockets (Redis 7 Gestionado) ───
REDIS_HOST=cache
REDIS_PORT=6379
CELERY_BROKER_URL=redis://cache:6379/0
CELERY_RESULT_BACKEND=redis://cache:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ─── Almacenamiento de Multimedia y Activos (S3 / Cloudflare R2 / MinIO) ───
# Opciones para MEDIA_STORAGE_BACKEND: 's3', 'r2', 'minio' o 'local'
MEDIA_STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mybookconnect-media-prod
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=eu-west-1
MEDIA_BASE_URL=https://media.mybookconnect.com

# ─── Correo Electrónico y Verificación de Cuentas (SMTP Transaccional) ───
DEFAULT_FROM_EMAIL=MyBookConnect <noreply@mybookconnect.com>
REQUIRE_EMAIL_VERIFICATION=1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=tu_sendgrid_api_key_aqui

# ─── Autenticación Social (Google OAuth 2.0) ───
GOOGLE_OAUTH_CLIENT_ID=tu_google_client_id_produccion.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu_google_client_id_produccion.apps.googleusercontent.com

# ─── Motor de Inteligencia Artificial (OpenAI / OpenRouter / Ollama) ───
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=tu_openai_api_key_aqui
AI_MODEL_CHAT=gpt-4o-mini
AI_MODEL_EMBEDDINGS=text-embedding-3-small
AI_TIMEOUT=20
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=100
AI_RATE_LIMIT_PER_DAY=500

# ─── Copias de Seguridad y Retención ───
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=clave_aes256_hexadecimal_de_64_caracteres_para_backups

# ─── Monetización y Afiliados (Fase 31) ───
AMAZON_AFFILIATE_TAG=mybooksocial-21
VITE_AMAZON_AFFILIATE_TAG=mybooksocial-21
