# Django settings
DEBUG=1
SECRET_KEY=change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database settings
POSTGRES_DB=mybookconnect
POSTGRES_USER=change_this_user
POSTGRES_PASSWORD=change_this_password

# Motor de Inteligencia Artificial (Compatible con OpenAI: Ollama, OpenAI, Groq)
AI_ENABLED=true
AI_API_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL_CHAT=llama3.2
AI_MODEL_EMBEDDINGS=nomic-embed-text
AI_TIMEOUT=15

# APIs Externas
