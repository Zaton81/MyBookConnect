# Django settings
DEBUG=1
SECRET_KEY=change-this-in-production-use-a-strong-random-key
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173 http://localhost:8000

# Production Security & SSL Directives (Active when DEBUG=0)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Database settings
POSTGRES_DB=mybookconnect
POSTGRES_USER=change_this_user
POSTGRES_PASSWORD=change_this_password

# Motor de Inteligencia Artificial (Compatible con OpenAI: Ollama, OpenAI, Groq)
AI_ENABLED=true
AI_API_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL_CHAT=llama3.2
AI_MODEL_EMBEDDINGS=nomic-embed-text
AI_TIMEOUT=15

# APIs Externas
GOOGLE_BOOKS_API_KEY=