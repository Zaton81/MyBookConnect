# Rellena estas variables con tus propios valores

# PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mybookconnect

# Django & Seguridad
SECRET_KEY=cambiar_por_una_clave_segura_en_produccion
DEBUG=1
ALLOWED_HOSTS=localhost 127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_URL=panel-gestion-mbc-segura/

# Autenticación Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Correo y Verificación
DEFAULT_FROM_EMAIL=noreply@mybooksocial.com
REQUIRE_EMAIL_VERIFICATION=0

# Motor de Inteligencia Artificial (Compatible con OpenAI: Ollama, OpenAI, Groq, LM Studio)
AI_ENABLED=true
AI_API_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL_CHAT=llama3.2
AI_MODEL_EMBEDDINGS=nomic-embed-text
AI_TIMEOUT=15
