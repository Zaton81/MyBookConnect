# Rellena estas variables con tus propios valores

# PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mybookconnect

# Django & Seguridad
SECRET_KEY=cambiar_por_una_clave_segura_en_produccion
DEBUG=1
ALLOWED_HOSTS=localhost 127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Motor de Inteligencia Artificial (Compatible con OpenAI: Ollama, OpenAI, Groq, LM Studio)
AI_ENABLED=true
AI_API_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL_CHAT=llama3.2
AI_MODEL_EMBEDDINGS=nomic-embed-text
AI_TIMEOUT=15
